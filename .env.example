# Copy to .env and fill in. Everything here is free. Nothing is strictly required locally: without
# GROQ_API_KEY verdicts come from rules alone, and other checks are skipped when their key is missing.

# Free, no card: https://console.groq.com/keys (Groq says it doesn't train on your data)
GROQ_API_KEY=
# development (default locally) | production (default on Render/Railway/Fly; any value other than
# "development" also counts). Production refuses to start without the Groq key or with WhatsApp only
# partly set up, and rejects unsigned webhooks.
# SCAMCHECK_ENV=development
# SCAMCHECK_MODEL=openai/gpt-oss-120b
# Where the "seen before" history of scam links, numbers and UPI IDs is kept (default runtime/scamcheck.db).
# SCAMCHECK_DB=

# https://developers.google.com/safe-browsing/v4/get-started  (free)
GOOGLE_SAFE_BROWSING_KEY=
# https://www.virustotal.com/gui/my-apikey  (free tier: 4 lookups/min, 500/day)
VIRUSTOTAL_API_KEY=

# WhatsApp via Meta's free Cloud API test number (developers.facebook.com → your app → WhatsApp → API Setup).
# Set all four, or none for web-only. The test number replies only to the (up to 5) numbers you register there.
WHATSAPP_PHONE_NUMBER_ID=
# API Setup's temporary token lasts 24 h; a System User token (Business settings) doesn't expire.
WHATSAPP_ACCESS_TOKEN=
# App settings → Basic → App secret. Used to check every webhook really comes from Meta.
WHATSAPP_APP_SECRET=
# Any word you choose; type the same word in WhatsApp → Configuration → Webhook → Verify token.
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v26.0
# Your own phone number(s), comma-separated, e.g. +919876543210. Only these show their full investigation
# in the web page's live feed (for live demos); everyone else's message content stays private.
DEMO_NUMBERS=
