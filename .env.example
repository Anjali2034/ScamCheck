# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required; every other check
# is skipped gracefully (and the agent is told so) when its key is missing.

ANTHROPIC_API_KEY=
# development (default locally) | production (default on Render/Railway/Fly; any value other than
# "development" also counts). Production refuses to start without the Anthropic key, Twilio credentials and
# an https PUBLIC_BASE_URL, and rejects unsigned webhooks.
# SCAMCHECK_ENV=development
# SCAMCHECK_MODEL=claude-opus-5-5
# SCAMCHECK_EFFORT=medium        # low | medium | high | xhigh | max

# https://developers.google.com/safe-browsing/v4/get-started  (free)
GOOGLE_SAFE_BROWSING_KEY=
# https://www.virustotal.com/gui/my-apikey  (free tier: 4 lookups/min, 500/day)
VIRUSTOTAL_API_KEY=

# Twilio WhatsApp sandbox: https://console.twilio.com → Messaging → Try it out → Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public URL Twilio calls (your ngrok URL), needed to verify Twilio's request signature
PUBLIC_BASE_URL=
# Your own phone number(s), comma-separated, e.g. +919876543210. Only these show their full investigation
# in the web page's live feed (for live demos); everyone else's message content stays private.
DEMO_NUMBERS=
