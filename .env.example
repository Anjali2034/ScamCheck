# Copy to .env and fill in. Every key is free and optional: without GROQ_API_KEY, verdicts come from the rules
# alone, and any check whose key is missing is skipped.

# --- AI ---------------------------------------------------------------------------------------------------------
# https://console.groq.com/keys (no card; Groq states it doesn't train on customer data)
GROQ_API_KEY=
# SCAMCHECK_MODEL=openai/gpt-oss-120b

# --- Environment --------------------------------------------------------------------------------------------------
# development (default locally) or production (default on Render, Railway and Fly; any other value also counts as
# production). Production refuses to start without the Groq key or with WhatsApp partly set up, and rejects
# unsigned webhooks.
# SCAMCHECK_ENV=development
# Where the "seen before" history and usage counters are kept (default runtime/scamcheck.db).
# SCAMCHECK_DB=

# --- Link reputation ----------------------------------------------------------------------------------------------
# https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=
# https://www.virustotal.com/gui/my-apikey (4 lookups a minute, 500 a day)
VIRUSTOTAL_API_KEY=

# --- WhatsApp (Meta Cloud API) ------------------------------------------------------------------------------------
# developers.facebook.com → your app → WhatsApp → API Setup. Set all four, or none for web only.
# The free test number replies only to the (up to 5) numbers registered there.
WHATSAPP_PHONE_NUMBER_ID=
# API Setup's temporary token lasts 24 hours; a System User token (Business settings) doesn't expire.
WHATSAPP_ACCESS_TOKEN=
# App settings → Basic → App secret. Used to verify that every webhook comes from Meta.
WHATSAPP_APP_SECRET=
# Any word you choose; enter the same word in WhatsApp → Configuration → Webhook → Verify token.
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v26.0
# Your own number(s), comma-separated, e.g. +919876543210. Only these show their full investigation in the live
# feed (for demos); everyone else's message content stays private.
DEMO_NUMBERS=

# --- Free-tier limits (README → Free-tier limits) -----------------------------------------------------------------
# Defaults fit Groq's and Meta's free tiers; an invalid value keeps the default.
# SCAMCHECK_AI_DAILY_TOKENS=180000
# SCAMCHECK_AI_CHECKS_PER_PERSON=25
# SCAMCHECK_WEB_CHECKS_PER_10_MIN=30
# SCAMCHECK_WHATSAPP_MONTHLY_MESSAGES=950
# SCAMCHECK_WHATSAPP_CHECKS_PER_DAY=40
# Where WhatsApp users are sent when the month's free replies run out. Set automatically on Render.
# SCAMCHECK_PUBLIC_URL=https://your-app.onrender.com
